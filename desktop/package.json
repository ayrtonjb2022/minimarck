{
  "name": "minimarck-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "MiniMarck Desktop — offline Electron + SQLite desktop app for the POS",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "spike": "electron src/main/spike/node-sqlite.spike.js",
    "probe:launch": "electron out/main/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:offline": "node scripts/verify-offline.mjs",
    "verify:s0": "npm run spike && npm test && npm run build && npm run verify:offline"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-vite": "^4.0.1",
    "vite": "^7.1.14",
    "vitest": "^3.2.4"
  }
}
