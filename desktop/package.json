{
  "name": "minimarck-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "MiniMarck Desktop — offline Electron + SQLite desktop app for the POS",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "spike": "electron src/main/spike/node-sqlite.spike.js",
    "probe:launch": "node scripts/probe-launch.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:offline": "node scripts/verify-offline.mjs",
    "verify:preload": "node scripts/assert-preload-format.mjs",
    "verify:migrations": "node scripts/assert-migrations-packaged.mjs",
    "db:reset": "node scripts/db-reset.mjs",
    "db:reset:force": "node scripts/db-reset.mjs --force",
    "verify:s0": "npm run spike && npm test && npm run build && npm run verify:preload && npm run verify:migrations && npm run verify:offline && npm run probe:launch"
  },
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "44.4.5",
    "electron-vite": "^4.0.1",
    "vite": "^7.1.14",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "react-toastify": "^10.0.6"
  }
}
